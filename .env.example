# ==============================================================================
# VARIABLES D'ENVIRONNEMENT GLOBALES - BILLETTERIE INTELLIGENTE
# ==============================================================================

# Clé secrète partagée pour la signature des jetons JWT (tous services)
JWT_SECRET=votre_cle_secrete_jwt_robuste_et_partagee

# ------------------------------------------------------------------------------
# Backend - Service Utilisateurs (port 5050)
# ------------------------------------------------------------------------------
PORT=5050
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/billetterie
MONGO_URI_TEST=mongodb://localhost:27017/billetterie_test
EMAIL_USER=votre_adresse@example.com
EMAIL_PASS=votre_mot_de_passe_ou_app_password

# ------------------------------------------------------------------------------
# Service Abonnements (port 5065)
# ------------------------------------------------------------------------------
ABONNEMENTS_PORT=5065
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=billetterie_abonnements
MYSQL_USER=root
MYSQL_PASSWORD=

# ------------------------------------------------------------------------------
# Service Billetterie & Bornes (port 5070)
# ------------------------------------------------------------------------------
BILLETTERIE_PORT=5070
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=billetterie_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ------------------------------------------------------------------------------
# Frontend Vite React (port 5173)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5050/api
VITE_ABONNEMENTS_API_URL=http://localhost:5065/api/abonnements
VITE_BILLETTERIE_API_URL=http://localhost:5070/api/billetterie
