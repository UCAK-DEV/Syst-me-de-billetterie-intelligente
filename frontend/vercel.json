{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://billetterie.167-86-91-52.sslip.io/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://billetterie.167-86-91-52.sslip.io/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
